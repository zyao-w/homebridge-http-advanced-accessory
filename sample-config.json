{
    "bridge": {
        "name": "Homebridge",
        "username": "C1:38:5A:AC:39:40",
        "port": 51826,
        "pin": "000-00-000"
    },
    "description": "This is an example configuration for the Everything Homebridge plugin",
    "accessories": [],
    "platforms": [
        {
            "platform": "HttpAdvancedPlatform",
            "name": "HTTP Advanced",
            "devices": [
                {
                    "name": "Terrace Sensor",
                    "service": "ContactSensor",
                    "forceRefreshDelay": 5,
                    "debug": false,
                    "username": "admin",
                    "password": "admin",
                    "characteristics": [
                        {
                            "characteristic": "ContactSensorState",
                            "get": {
                                "url": "http://localhost/xml/zones/zonesStatus48IP.xml",
                                "mappers": [
                                    {
                                        "type": "xpath",
                                        "xpath": "//status[1]/text()"
                                    },
                                    {
                                        "type": "static",
                                        "mapping": [
                                            {
                                                "from": "ALARM",
                                                "to": "1"
                                            },
                                            {
                                                "from": "NORMAL",
                                                "to": "0"
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Condizionatore Soggiorno",
                    "service": "HeaterCooler",
                    "forceRefreshDelay": 5,
                    "debug": false,
                    "characteristics": [
                        {
                            "characteristic": "CurrentHeaterCoolerState",
                            "get": {
                                "url": "http://192.168.201.16/aircon/get_control_info",
                                "mappers": [
                                    {
                                        "type": "regex",
                                        "regexp": "(pow=0)",
                                        "capture": "1"
                                    },
                                    {
                                        "type": "regex",
                                        "regexp": "mode=(\\d)",
                                        "capture": "1"
                                    },
                                    {
                                        "type": "static",
                                        "mapping": [
                                            {
                                                "from": "3",
                                                "to": "3"
                                            },
                                            {
                                                "from": "4",
                                                "to": "2"
                                            },
                                            {
                                                "from": "pow=0",
                                                "to": "0"
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "characteristic": "TargetHeaterCoolerState",
                            "get": {
                                "url": "http://192.168.201.16/aircon/get_control_info",
                                "mappers": [
                                    {
                                        "type": "regex",
                                        "regexp": "(pow=0)",
                                        "capture": "1"
                                    },
                                    {
                                        "type": "regex",
                                        "regexp": "mode=(\\d)",
                                        "capture": "1"
                                    },
                                    {
                                        "type": "static",
                                        "mapping": [
                                            {
                                                "from": "3",
                                                "to": "3"
                                            },
                                            {
                                                "from": "4",
                                                "to": "2"
                                            },
                                            {
                                                "from": "pow=0",
                                                "to": "0"
                                            }
                                        ]
                                    }
                                ]
                            },
                            "set": {
                                "url": "http://192.168.201.16/aircon/set_control_info/{value}&pow=${state.Active}&",
                                "mappers": [
                                    {
                                        "type": "static",
                                        "mapping": [
                                            {
                                                "from": "0",
                                                "to": "?mode=0"
                                            },
                                            {
                                                "from": "1",
                                                "to": "?mode=4"
                                            },
                                            {
                                                "from": "2",
                                                "to": "?mode=3"
                                            }
                                        ]
                                    }
                                ]
                            }
                        },
                        {
                            "characteristic": "Active",
                            "get": {
                                "url": "http://192.168.201.16/aircon/get_control_info",
                                "mappers": [
                                    {
                                        "type": "regex",
                                        "regexp": "pow=(\\d)",
                                        "capture": "1"
                                    }
                                ]
                            },
                            "set": {
                                "url": "http://192.168.201.16/aircon/set_control_info/{value}",
                                "mappers": [
                                    {
                                        "type": "static",
                                        "mapping": [
                                            {
                                                "from": "0",
                                                "to": "?pow=0"
                                            },
                                            {
                                                "from": "1",
                                                "to": "?pow=1"
                                            }
                                        ]
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "CO2 Sensor",
                    "service": "CarbonDioxideSensor",
                    "forceRefreshDelay": 30,
                    "debug": false,
                    "bearerToken": "env:CO2_API_TOKEN",
                    "characteristics": [
                        {
                            "characteristic": "CarbonDioxideLevel",
                            "get": {
                                "url": "https://example.com/api/",
                                "mappers": [
                                    {
                                        "type": "jpath",
                                        "jpath": "$.data.co2"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
