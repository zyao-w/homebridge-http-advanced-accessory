{
  "pluginAlias": "HttpAdvancedPlatform",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Turns devices that expose an HTTP API into HomeKit accessories. Settings under *Defaults* apply to every device unless the device sets its own.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "placeholder": "HTTP Advanced"
      },
      "defaults": {
        "type": "object",
        "properties": {
          "forceRefreshDelay": {
            "title": "Polling interval (seconds)",
            "type": "number",
            "minimum": 0,
            "placeholder": "0",
            "description": "0 disables polling."
          },
          "setterDelay": {
            "title": "Setter delay (ms)",
            "type": "number",
            "minimum": 0,
            "placeholder": "0",
            "description": "Wait before sending a set request; only the last value is sent."
          },
          "bearerToken": {
            "title": "Bearer token",
            "type": "string",
            "widget": "password",
            "x-schema-form": {
              "type": "password"
            },
            "description": "A literal token, env:NAME for an environment variable, or file:/path/to/token."
          },
          "username": {
            "title": "Username (Basic auth)",
            "type": "string"
          },
          "password": {
            "title": "Password (Basic auth)",
            "type": "string",
            "widget": "password",
            "x-schema-form": {
              "type": "password"
            }
          },
          "immediately": {
            "title": "Send Basic credentials immediately",
            "type": "boolean",
            "description": "When off, credentials are sent only after the server answers 401."
          },
          "timeout": {
            "title": "Request timeout (ms)",
            "type": "number",
            "minimum": 0,
            "placeholder": "10000",
            "description": "0 disables the timeout."
          },
          "retries": {
            "title": "Read retries",
            "type": "integer",
            "minimum": 0,
            "placeholder": "0"
          },
          "cacheTTL": {
            "title": "Cache lifetime (seconds)",
            "type": "number",
            "minimum": 0,
            "description": "Defaults to the polling interval."
          },
          "maxConcurrent": {
            "title": "Maximum concurrent requests",
            "type": "integer",
            "minimum": 0,
            "placeholder": "0",
            "description": "0 means unlimited."
          },
          "allowUnsafeEval": {
            "title": "Allow unsafe eval",
            "type": "boolean",
            "description": "Allows script mappers and JavaScript in ${...} templates, which run arbitrary code with the privileges of Homebridge."
          },
          "debug": {
            "title": "Debug logging",
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "title": "Defaults"
      },
      "devices": {
        "title": "Devices",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name",
              "type": "string",
              "description": "Name shown in HomeKit."
            },
            "service": {
              "title": "Service",
              "type": "string",
              "placeholder": "Switch",
              "description": "HomeKit service type, for example Switch, Lightbulb or TemperatureSensor."
            },
            "characteristics": {
              "title": "Characteristics",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "characteristic": {
                    "title": "Characteristic",
                    "type": "string",
                    "placeholder": "On",
                    "description": "Characteristic name, for example On or Brightness."
                  },
                  "get": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "title": "URL",
                        "type": "string"
                      },
                      "httpMethod": {
                        "title": "HTTP method",
                        "type": "string",
                        "oneOf": [
                          {
                            "title": "GET",
                            "enum": [
                              "GET"
                            ]
                          },
                          {
                            "title": "POST",
                            "enum": [
                              "POST"
                            ]
                          },
                          {
                            "title": "PUT",
                            "enum": [
                              "PUT"
                            ]
                          },
