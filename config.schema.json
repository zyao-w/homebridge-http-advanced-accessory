                              "PATCH"
                            ]
                          },
                          {
                            "title": "DELETE",
                            "enum": [
                              "DELETE"
                            ]
                          }
                        ],
                        "description": "Defaults to GET."
                      },
                      "body": {
                        "title": "Body",
                        "type": "string",
                        "widget": "textarea"
                      },
                      "resultOnError": {
                        "title": "Result on error",
                        "type": "string",
                        "description": "Used as the value when the request fails, instead of reporting an error."
                      },
                      "bearerToken": {
                        "title": "Bearer token",
                        "type": "string",
                        "widget": "password",
                        "x-schema-form": {
                          "type": "password"
                        },
                        "description": "Overrides the device token for this action. A literal token, env:NAME for an environment variable, or file:/path/to/token."
